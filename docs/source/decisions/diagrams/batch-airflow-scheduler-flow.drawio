        <mxCell id="a1" value="1. Every-minute DAG&#xa;loops configured offices" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed" vertex="1" parent="1"><mxGeometry x="55" y="115" width="225" height="92" as="geometry"/></mxCell>
