        <mxCell id="a4" value="4. Timezone due check&#xa;hourly minute or cron; DST gaps skipped, repeats once" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a" vertex="1" parent="1"><mxGeometry x="615" y="280" width="255" height="108" as="geometry"/></mxCell>
        <mxCell id="a5" value="5. POST /jobs&#xa;due rows only, nonblocking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a" vertex="1" parent="1"><mxGeometry x="335" y="280" width="225" height="108" as="geometry"/></mxCell>
